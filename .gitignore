# pyenv
#   For a library or app, you might want to share your .python-version if the
#   project is co-developed in multiple versions of Python.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, in case of collaboration, if cloud platform requires it or because of differences
#   in dependencies, users may prefer to ignore Pipfile.lock.
#   In Sparkline, we use Poetry, so we will keep poetry.lock and ignore pipenv
# Pipfile.lock

# poetry
#   We keep poetry.lock tracked under git, but ignore the virtualenv if created inside the project
.venv/
venv/
ENV/
env/

# environments
.env
.env.prod
.env.dev

