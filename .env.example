# ─────────────────────────────────────────────────────────────────
# Sparkline LLM + RAG — Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Service authentication (trusted gateway) ──────────────────────
# Lets the Open WebUI pipeline request a session for a user it has already
# authenticated, instead of replaying that user's password. Set this to a long
# random value (python -c "import secrets; print(secrets.token_urlsafe(48))")
# and put the same value in the pipeline's service_token valve.
# Leave empty to disable the route — it fails closed, never open.
SERVICE_TOKEN=
# Minimum length enforced on any password set through the API.
MIN_PASSWORD_LENGTH=8

# ── PostgreSQL (shared with Dhruv's enterprise adapters) ─────────
POSTGRES_USER=sparkline
POSTGRES_PASSWORD=sparkline_secret
POSTGRES_DB=sparkline_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full DSN (constructed from above in settings.py, but can be overridden)
# DATABASE_URL=postgresql+asyncpg://sparkline:sparkline_secret@localhost:5432/sparkline_db

# ── Redis (Document RAG only — NOT shared with enterprise adapters) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0
REDIS_SESSION_TTL_SECONDS=3600

# ── MinIO (Document RAG raw file storage) ─────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret
MINIO_BUCKET_DOCUMENTS=sparkline-documents
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Qdrant (Vector DB — Document RAG only) ────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=sparkline_documents
QDRANT_VECTOR_SIZE=1024
# API key if Qdrant is in cloud/secure mode (leave blank for local)
QDRANT_API_KEY=

# ── LLM Serving — OpenAI-compatible endpoint ──────────────────────
# Switch between Ollama (dev) and vLLM (prod) by changing these two lines only.
# Application code NEVER references the serving backend directly.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen2.5:14b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
OLLAMA_PORT=11434

# ── Embeddings ────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-large-en
EMBEDDING_DEVICE=cpu
# Set to 'cuda' once RTX 5060 Ti is available:
# EMBEDDING_DEVICE=cuda

# ── Reranker ──────────────────────────────────────────────────────
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
# Set to 'cuda' once RTX 5060 Ti is available:
# RERANKER_DEVICE=cuda

# ── Retrieval Settings ────────────────────────────────────────────
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_BM25=20
# Candidates fed to the cross-encoder reranker after the RRF merge.
# Must exceed RETRIEVAL_TOP_K_RERANK or the reranker cannot promote anything.
RETRIEVAL_TOP_K_FUSION=20
RETRIEVAL_TOP_K_RERANK=5
RETRIEVAL_RRF_K=60

# ── Chunking Settings ─────────────────────────────────────────────
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
# Max chunks indexed from one document. Embedding is CPU-bound at ~3
# chunks/sec, so 1000 is roughly a five-minute upload. Larger files are
# indexed proportionally across their sheets/pages and the uploader is told.
INGEST_MAX_CHUNKS_PER_DOCUMENT=1000

# ── Query Routing ─────────────────────────────────────────────────
# evidence = retrieve first, then route on the top cross-encoder rerank score.
# legacy   = send every query to the RAG agent (pre-2026-08-11 behaviour).
ROUTER_MODE=evidence
# Rerank scores are raw logits (~-11..+11), not probabilities, and the useful
# split point depends on the corpus. Measure yours before changing these:
#   docker compose -f docker-compose.yml -f docker-compose.server.yml \
#       exec api python -m eval.calibrate_router
#   score >= HIGH       → documents only, strict grounded prompt
#   LOW <= score < HIGH → documents supplied, general knowledge permitted
#   score < LOW         → general knowledge only, no citations
ROUTER_RAG_SCORE_HIGH=-2.0
ROUTER_RAG_SCORE_LOW=-5.5
# Retry in general mode if a document answer still comes back as "not found".
ROUTER_ENABLE_GENERAL_FALLBACK=true
# Expand short follow-ups with the previous question before retrieving.
ROUTER_CONDENSE_FOLLOWUPS=true

# ── Typo Tolerance ────────────────────────────────────────────────
# A misspelled document question retrieves worse and can fall out of the
# document band into general knowledge, so this is part of routing.
# Corrections are drawn from the vocabulary of whatever documents are currently
# ingested, rebuilt on every ingestion — nothing is tied to a specific corpus.
TYPO_CORRECTION_ENABLED=true
# Tokens shorter than this are never corrected.
TYPO_MIN_TOKEN_LENGTH=4
# Damerau-Levenshtein budget: 1 edit for 4-6 char tokens, up to this for 7+.
TYPO_MAX_EDIT_DISTANCE=2
# Second pass for sound-alike misspellings ("diprisiation" -> "depreciation").
TYPO_PHONETIC_ENABLED=true
# Never "correct" an ordinary English word just because the documents do not
# use it. Word list is the reranker's own tokenizer vocabulary (~21k words).
TYPO_PROTECT_DICTIONARY_WORDS=true
# Tier 3: LLM rewrite when the cheap passes find nothing. Off by default —
# non-deterministic, costs a GPU round-trip, and rewrites domain terms.
TYPO_SEMANTIC_REWRITE_ENABLED=false
TYPO_SEMANTIC_REWRITE_TIMEOUT_SECONDS=15

# ── Access Control ────────────────────────────────────────────────
# Default role applied to pilot users who have no dept/designation yet.
DEFAULT_PILOT_ROLE=pilot_user

# ── API Gateway ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
